# fastlane/Appfile — идентификаторы приложения для fastlane.
# Чувствительные данные (credentials) — через переменные окружения, не здесь.

# iOS
app_identifier "com.plantcare.plantcareMobile"
apple_id ENV["APPLE_ID"] # email Apple Developer аккаунта (из GitHub Secret APPLE_ID)
itc_team_id ENV["APP_STORE_CONNECT_TEAM_ID"]   # App Store Connect team ID
team_id ENV["APPLE_TEAM_ID"]                   # Developer Portal team ID

# Android
# package_name задаётся в lane через параметр, т.к. dev/prod различаются:
#   dev:  com.plantcare.plantcareMobile.dev
#   prod: com.plantcare.plantcareMobile
